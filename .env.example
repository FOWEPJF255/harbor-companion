# Keep real credentials in .env, never in the browser or repository.
HARBOR_PROVIDER=mock
# A provider base URL including its version prefix, for example https://api.openai.com/v1
HARBOR_API_BASE=
HARBOR_API_KEY=
HARBOR_MODEL=
HARBOR_TIMEOUT_SECONDS=30
HARBOR_MAX_STEPS=4
HARBOR_DB=data/harbor.sqlite3
