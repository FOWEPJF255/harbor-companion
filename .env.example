# Keep real credentials in .env, never in the browser or repository.
HARBOR_PROVIDER=mock
# A provider base URL including its version prefix, for example https://api.openai.com/v1
HARBOR_API_BASE=
HARBOR_API_KEY=
HARBOR_MODEL=
HARBOR_TIMEOUT_SECONDS=30
HARBOR_MAX_STEPS=4
HARBOR_TOOL_TIMEOUT_SECONDS=3
HARBOR_DB=data/harbor.sqlite3

# Management tokens expire on restart or after this bounded lifetime.
HARBOR_ADMIN_TOKEN_MINUTES=60

# Keep empty for the default local demo. Remote access is an explicit deployment step.
# Initialize the administrator locally BEFORE setting additional hosts.
# Exact hostnames and HTTPS origins only; no wildcards. Native origins are built in.
HARBOR_ALLOWED_HOSTS=
HARBOR_ALLOWED_ORIGINS=
# Remote demo access code (at least 32 characters); distinct from the model API key.
HARBOR_CLIENT_TOKEN=
